{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pastry Management",
  "version": "0.3.1",
  "identifier": "com.pastrymanagement.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pastry Management",
        "width": 1280,
        "height": 832,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0MkQxODhERDI4NkY3Q0QKUldUTjk0YlNqUmd0dEZrSitRbjRjRWN5eGU2K1NwMTFaT01zQUFqMG9VZ3dXUWtDQ2UrS1JFUUIK",
      "endpoints": [
        "https://github.com/monopolatos/pastry-management/releases/latest/download/latest.json"
      ]
    }
  }
}
